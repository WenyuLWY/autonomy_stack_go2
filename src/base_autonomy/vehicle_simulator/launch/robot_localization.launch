<launch>

  <!-- <arg name="world_name" default="real_world"/>
  <arg name="sensorOffsetX" default="0.3"/>
  <arg name="sensorOffsetY" default="0.0"/>
  <arg name="cameraOffsetZ" default="0.0"/>

  <!-- <include file="$(find-pkg-share realsense2_camera)/launch/rs_launch.py">
  </include>

  <node pkg="mogi_trajectory_server" exec="mogi_trajectory_server" name="mogi_trajectory_server" output="screen">
    <param name="trajectory_topic"   value="trajectory" />
    <param name="reference_frame_id" value="map" />
    <param name="robot_frame_id"     value="sensor" />
    <param name="update_rate"        value="5.0" />
